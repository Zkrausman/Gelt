# ====================================================================
# GELT AGENTIC TRADING SUITE - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# This is a template file. DO NOT place real API keys or secrets here.
# Copy this file to '.env' and populate it with your specific values.

# --------------------------------------------------------------------
# GOOGLE ANTIGRAVITY & GEMINI ORCHESTRATOR
# NOTE: Primary configuration is stored in ~/.gelt/config.json (gemini_api_key & gemini_models).
# Environment variables below serve as optional high-priority overrides.
# --------------------------------------------------------------------
# Google Antigravity / Gemini REST API Key
GEMINI_API_KEY=

# Comma-separated list of authorized Gemini model names for random sampling & failover.
# Default pool: gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-flash-lite, gemini-flash-latest, gemini-2.5-pro, gemini-2.5-flash-lite
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-2.5-pro,gemini-2.5-flash-lite

# Central BeadsBrain OKF thesis storage directory path.
# No workstation-specific default is published.
GELT_BEADS_BRAIN_PATH=

# --------------------------------------------------------------------
# ROBINHOOD MCP INTEGRATION
# --------------------------------------------------------------------
# Your Robinhood Agentic MCP Server URL.
ROBINHOOD_MCP_URL=

# Robinhood OAuth Credentials
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=

# --------------------------------------------------------------------
# NOTIFICATIONS (DISCORD)
# --------------------------------------------------------------------
# Discord Webhook URL for the async notification engine.
DISCORD_WEBHOOK_URL=

# --------------------------------------------------------------------
# MACRO MATRIX (FRED API)
# --------------------------------------------------------------------
# Federal Reserve Economic Data (FRED) API Key.
FRED_API_KEY=

# --------------------------------------------------------------------
# REDDIT SENTIMENT INTEGRATION
# --------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --------------------------------------------------------------------
# DATA STORAGE & LOGGING
# --------------------------------------------------------------------
GELT_DB_PATH=
LOG_LEVEL=info
