{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegimeMatrix",
  "type": "object",
  "properties": {
    "Score": {
      "type": "number",
      "description": "Macro volatility flag (e.g. baseline or risk score)"
    },
    "VolatilityFlags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Macro volatility flags"
    },
    "MarketSentiment": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Market sentiment scores (0–100)"
    },
    "AssetBiases": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Asset-level bias indicators"
    }
  },
  "required": ["Score", "MarketSentiment"]
}
